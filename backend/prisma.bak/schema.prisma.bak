generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @db.SmallInt
  name  String @unique @db.VarChar(30)
  users User[]

  @@map("roles")
}

model User {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String                 @db.VarChar(100)
  email                   String                 @unique @db.VarChar(255)
  password_hash           String                 @db.VarChar(255)
  role_id                 Int                    @db.SmallInt
  location_id             String?                @db.Uuid
  is_active               Boolean                @default(true)
  created_at              DateTime               @default(now()) @db.Timestamptz
  updated_at              DateTime               @default(now()) @updatedAt @db.Timestamptz
  role                    Role                   @relation(fields: [role_id], references: [id], onDelete: Restrict)
  location                Location?              @relation(fields: [location_id], references: [id], onDelete: SetNull)
  refresh_tokens          RefreshToken[]
  inventory_transactions  InventoryTransaction[]
  work_orders_assigned    WorkOrder[]            @relation("AssignedTo")
  work_orders_created     WorkOrder[]            @relation("CreatedBy")
  transfers_requested     InternalTransfer[]     @relation("RequestedBy")
  transfers_dispatched    InternalTransfer[]     @relation("DispatchedBy")
  transfers_received      InternalTransfer[]     @relation("ReceivedBy")
  customer_orders_created CustomerOrder[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @db.VarChar(255)
  family_id  String    @db.Uuid
  expires_at DateTime  @db.Timestamptz
  revoked_at DateTime? @db.Timestamptz
  created_at DateTime  @default(now()) @db.Timestamptz
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
  @@map("refresh_tokens")
}

model Location {
  id                             String                 @id @db.Uuid
  code                           String                 @unique @db.VarChar(20)
  name                           String                 @db.VarChar(100)
  is_active                      Boolean                @default(true)
  created_at                     DateTime               @default(now()) @db.Timestamptz
  users                          User[]
  inventory                      Inventory[]
  work_orders                    WorkOrder[]
  transfers_source               InternalTransfer[]     @relation("SourceLocation")
  transfers_destination          InternalTransfer[]     @relation("DestinationLocation")
  customer_order_items_fulfilled CustomerOrderItem[]

  @@map("locations")
}

model Category {
  id         String   @id @db.Uuid
  name       String   @unique @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz
  items      Item[]

  @@map("categories")
}

model Item {
  id                   String              @id @db.Uuid
  sku                  String              @unique @db.VarChar(50)
  name                 String              @db.VarChar(150)
  category_id          String              @db.Uuid
  unit_of_measure      String              @default("EA") @db.VarChar(20)
  allow_fractional     Boolean             @default(false)
  is_active            Boolean             @default(true)
  created_at           DateTime            @default(now()) @db.Timestamptz
  category             Category            @relation(fields: [category_id], references: [id], onDelete: Restrict)
  batches              Batch[]
  inventory            Inventory[]
  work_orders          WorkOrder[]
  transfers            InternalTransfer[]
  customer_order_items CustomerOrderItem[]

  @@index([category_id])
  @@index([sku])
  @@map("items")
}

model Batch {
  id           String             @id @db.Uuid
  item_id      String             @db.Uuid
  batch_number String             @db.VarChar(50)
  expiry_date  DateTime?          @db.Date
  created_at   DateTime           @default(now()) @db.Timestamptz
  item         Item               @relation(fields: [item_id], references: [id], onDelete: Cascade)
  inventory    Inventory[]
  transfers    InternalTransfer[]
  order_items  CustomerOrderItem[]

  @@unique([item_id, batch_number])
  @@map("batches")
}

model Inventory {
  id                 String                 @id @db.Uuid
  item_id            String                 @db.Uuid
  location_id        String                 @db.Uuid
  batch_id           String                 @db.Uuid
  physical_quantity  Decimal                @default(0) @db.Decimal(14, 3)
  reserved_quantity  Decimal                @default(0) @db.Decimal(14, 3)
  available_quantity Decimal                @default(0) @db.Decimal(14, 3) // Will be converted to GENERATED ALWAYS AS
  version            Int                    @default(0)
  updated_at         DateTime               @default(now()) @updatedAt @db.Timestamptz
  item               Item                   @relation(fields: [item_id], references: [id], onDelete: Restrict)
  location           Location               @relation(fields: [location_id], references: [id], onDelete: Restrict)
  batch              Batch                  @relation(fields: [batch_id], references: [id], onDelete: Restrict)
  transactions       InventoryTransaction[]
  reservations       Reservation[]

  @@unique([item_id, location_id, batch_id])
  @@index([item_id, location_id])
  @@index([location_id])
  @@map("inventory")
}

model InventoryTransaction {
  id               String   @id @db.Uuid
  inventory_id     String   @db.Uuid
  transaction_type String   @db.VarChar(30)
  quantity_change  Decimal  @db.Decimal(14, 3)
  physical_before  Decimal  @db.Decimal(14, 3)
  physical_after   Decimal  @db.Decimal(14, 3)
  reserved_before  Decimal  @db.Decimal(14, 3)
  reserved_after   Decimal  @db.Decimal(14, 3)
  reference_type   String?  @db.VarChar(30)
  reference_id     String?  @db.Uuid
  idempotency_key  String?  @unique @db.VarChar(100)
  performed_by     String   @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz
  inventory        Inventory @relation(fields: [inventory_id], references: [id], onDelete: Restrict)
  user             User      @relation(fields: [performed_by], references: [id], onDelete: Restrict)

  @@index([inventory_id, created_at])
  @@index([reference_type, reference_id])
  @@map("inventory_transactions")
}

model WorkOrder {
  id                String   @id @db.Uuid
  location_id       String   @db.Uuid
  item_id           String   @db.Uuid
  required_quantity Decimal  @db.Decimal(14, 3)
  assigned_user_id  String   @db.Uuid
  created_by        String   @db.Uuid
  status            String   @default("ASSIGNED") @db.VarChar(20)
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz
  location          Location @relation(fields: [location_id], references: [id], onDelete: Restrict)
  item              Item     @relation(fields: [item_id], references: [id], onDelete: Restrict)
  assigned_user     User     @relation("AssignedTo", fields: [assigned_user_id], references: [id], onDelete: Restrict)
  creator           User     @relation("CreatedBy", fields: [created_by], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([location_id])
  @@index([assigned_user_id])
  @@map("work_orders")
}

model InternalTransfer {
  id                      String    @id @db.Uuid
  source_location_id      String    @db.Uuid
  destination_location_id String    @db.Uuid
  item_id                 String    @db.Uuid
  batch_id                String    @db.Uuid
  quantity                Decimal   @db.Decimal(14, 3)
  status                  String    @default("REQUESTED") @db.VarChar(20)
  requested_by            String    @db.Uuid
  dispatched_by           String?   @db.Uuid
  dispatched_at           DateTime? @db.Timestamptz
  received_by             String?   @db.Uuid
  received_at             DateTime? @db.Timestamptz
  created_at              DateTime  @default(now()) @db.Timestamptz
  source_location         Location  @relation("SourceLocation", fields: [source_location_id], references: [id], onDelete: Restrict)
  destination_location    Location  @relation("DestinationLocation", fields: [destination_location_id], references: [id], onDelete: Restrict)
  item                    Item      @relation(fields: [item_id], references: [id], onDelete: Restrict)
  batch                   Batch     @relation(fields: [batch_id], references: [id], onDelete: Restrict)
  requester               User      @relation("RequestedBy", fields: [requested_by], references: [id], onDelete: Restrict)
  dispatcher              User?     @relation("DispatchedBy", fields: [dispatched_by], references: [id])
  receiver                User?     @relation("ReceivedBy", fields: [received_by], references: [id])

  @@index([status])
  @@index([source_location_id])
  @@index([destination_location_id])
  @@map("internal_transfers")
}

model CustomerOrder {
  id                 String              @id @db.Uuid
  customer_reference String              @db.VarChar(150)
  created_by         String              @db.Uuid
  status             String              @default("PENDING") @db.VarChar(20)
  created_at         DateTime            @default(now()) @db.Timestamptz
  creator            User                @relation(fields: [created_by], references: [id], onDelete: Restrict)
  items              CustomerOrderItem[]

  @@map("customer_orders")
}

model CustomerOrderItem {
  id                String        @id @db.Uuid
  customer_order_id String        @db.Uuid
  item_id           String        @db.Uuid
  location_id       String        @db.Uuid
  batch_id          String        @db.Uuid
  quantity_requested Decimal      @db.Decimal(14, 3)
  status            String        @default("PENDING") @db.VarChar(20)
  created_at        DateTime      @default(now()) @db.Timestamptz
  customer_order    CustomerOrder @relation(fields: [customer_order_id], references: [id], onDelete: Cascade)
  item              Item          @relation(fields: [item_id], references: [id], onDelete: Restrict)
  location          Location      @relation(fields: [location_id], references: [id], onDelete: Restrict)
  batch             Batch         @relation(fields: [batch_id], references: [id], onDelete: Restrict)
  reservation       Reservation?

  @@map("customer_order_items")
}

model Reservation {
  id                     String            @id @db.Uuid
  customer_order_item_id String            @unique @db.Uuid
  inventory_id           String            @db.Uuid
  quantity               Decimal           @db.Decimal(14, 3)
  status                 String            @default("ACTIVE") @db.VarChar(20)
  created_at             DateTime          @default(now()) @db.Timestamptz
  customer_order_item    CustomerOrderItem @relation(fields: [customer_order_item_id], references: [id], onDelete: Restrict)
  inventory              Inventory         @relation(fields: [inventory_id], references: [id], onDelete: Restrict)

  @@map("reservations")
}
